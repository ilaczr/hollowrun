# Copy this file to frontend/.env.local for release builds only.
# Never commit the real authentication token.
# Uploads remain off unless this value is exactly "true".
SENTRY_UPLOAD_SOURCEMAPS=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=hollowrun

# Leave unset for sentry.io. Set only when using a self-hosted Sentry instance.
SENTRY_URL=https://de.sentry.io
